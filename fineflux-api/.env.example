PORT=8080
NODE_ENV=development
# All business timestamps are IST wall-clock; this must stay Asia/Kolkata regardless of
# host, or naive datetime strings (no UTC offset) get parsed wrong. Also force-set in
# code (config/env.js) so it holds even if this var is missing/misconfigured on deploy.
TZ=Asia/Kolkata

MONGODB_URI=mongodb://localhost:27017/fineflux

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

CORS_ORIGINS=http://localhost:5173,http://localhost:8080

GCS_BUCKET=fineflux-documents
GCS_PROJECT_ID=fineflux
GCS_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Keep the \n escapes literal (don't turn them into real newlines) — quote the whole value.
GCS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@example.com
SMTP_PASS=change-me
SMTP_FROM="FineFlux <noreply@example.com>"

FRONTEND_URL=http://localhost:5173

# PhonePe Business (PG Standard Checkout). Leave unset in dev — adapter throws a clear
# config error on first use instead of silently failing signature checks.
PHONEPE_ENV=sandbox
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
# Only needed if you must override the sandbox/production URL PHONEPE_ENV picks by default.
# PHONEPE_BASE_URL=

# Paytm Business (PG). Same story — get these from your Paytm integration rep.
PAYTM_ENV=sandbox
PAYTM_MERCHANT_ID=
PAYTM_MERCHANT_KEY=
PAYTM_WEBSITE=WEBSTAGING
# PAYTM_BASE_URL=

# How often the missed-webhook reconciliation sweep runs, in minutes.
RECONCILIATION_INTERVAL_MINUTES=15
